# Default hermes-agent pin (commit SHA), shared between:
#   - scripts/install.sh            (host installer — sources this file)
#   - backend/Dockerfile            (container build — passed via build-arg
#                                    and consumed by docker-entrypoint.sh for the
#                                    version-consistency check)
#
# Caveat: the hermes-agent installer (curl|bash black box) silently falls
# back to main HEAD when the pinned SHA isn't reachable from the default
# branch (cloned by `git clone`). To pin reliably, the SHA must be on
# `main` of NousResearch/hermes-agent. Resolve a tag like `v2026.8.19`
# to its commit SHA via `git ls-remote https://github.com/NousResearch/
# hermes-agent.git v2026.8.19^{}` and pin that.
#
# Override at install / build time by exporting HERMES_AGENT_COMMIT in the
# environment (both consumers honor the override).
# refs/tags/v2026.8.19
HERMES_AGENT_COMMIT="fcbd1076a93841fa88855acce810e342a5b78101"

# hermes-agent installer URL — FULL OVERRIDE ONLY, normally left unset.
# scripts/install.sh resolves the installer to match the ref being installed:
#   HERMES_AGENT_INSTALLER_URL set  → used as-is
#   HERMES_BRANCH / HERMES_COMMIT  → https://raw.githubusercontent.com/
#       NousResearch/hermes-agent/<ref>/scripts/install.sh  (content-addressed:
#       byte-identical to the tree's scripts/install.sh — no version skew)
#   neither                        → https://hermes-agent.nousresearch.com/
#       install.sh  (floating, tracks main)
# Set this only to install from a fork-hosted installer.
# HERMES_AGENT_INSTALLER_URL="https://hermes-agent.nousresearch.com/install.sh"
#
# Note: the pinned installer hardcodes GitHub upstream clone URLs and predates
# HERMES_REPO_URL support. scripts/install.sh rewrites those clone URLs to
# HERMES_REPO_URL before executing the installer, so the code that gets cloned
# always comes from the same source (fork) as HERMES_REPO_URL — no silent
# fallback to NousResearch/hermes-agent.

# Optional accelerator prefix prepended to the resolved installer URL (include
# trailing slash), for networks that cannot reach raw.githubusercontent.com
# directly, e.g. HERMES_INSTALLER_MIRROR="https://<gh-proxy>/". Empty = direct.
# Site-specific — pass via env/build-arg, never commit a value here.
# HERMES_INSTALLER_MIRROR=""

# Playwright browser revisions used as fallback when the mirror's
# browsers.json isn't available (e.g. registry.npmmirror.com as of
# 2026-10-08 doesn't mirror the manifest at all). Match the values shipped
# in hermes-agent's playwright-core package. Update when hermes-agent bumps
# playwright-core (currently 1.64.0 → chromium 1187, ffmpeg 1013).
PLAYWRIGHT_FALLBACK_CHROMIUM_REV="1187"
PLAYWRIGHT_FALLBACK_FFMPEG_REV="1013"