# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Backup and temporary files
*.bak
*.swp
*.swo

# Archive directory (pre-git backups, kept on disk but not tracked)
archive/

.claude/
CLAUDE.md
.cursorrules
.windsurfrules
.aider*
copilot-instructions.md
.codeflicker/
git_commit_head.txt

# Generated screenshots and transient artifacts
screenshot-*.png
full-UI.png

# Frontend build artifacts
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.tsbuildinfo
static/
*.log

# Version file written by Docker/CI build — generated, never committed
backend/app/api/_version.py

# OS files
.DS_Store
Thumbs.db

# Local reference clones — never committed
# (project docs themselves are tracked: docs/*.md and docs/images/)
docs/*
!docs/*.md
!docs/images/
!docs/images/**

# Local-only PR review harness: rendering drivers, sample bank, fixtures.
# Used by Claude during deep reviews; never shared in the repo.
.local-review/
graphify-out/

.venv
.lingyue-lab

# Buildah image store kept on a local ext4 mount for container builds
# (see BUILDAH_ROOT in scripts/build.sh). Can grow to hundreds of GB.
# Second pattern covers the misspelled runroot name the lab script sets.
.buildah-storage*/
.buldah-storage*/

# Regression test runner artifacts (junit XML, logs)
backend/tests/.results/

# Frontend test artifacts
frontend/tests/.results/
frontend/node_modules/.vite/

# Local container/agent runtime state (host-specific, never shared)
.hermes/
.podman-storage-root/
.storage.conf

# Site-local compose overrides (host network MTU, mirrors; see
# docker-compose.local.yml.example)
docker-compose.local.yml
