# All values are optional -- auto-discovery will fill in anything left blank.
# Path to your hermes-agent checkout (the repo that contains run_agent.py)
HERMES_WEBUI_AGENT_DIR=/usr/local/lib/hermes-agent

# Bind address (default: 127.0.0.1 -- loopback only, safe default)
HERMES_WEBUI_HOST=0.0.0.0

# Port to listen on (default: 8787)
HERMES_WEBUI_PORT=8787

# Webui password
HERMES_WEBUI_PASSWORD=lingyue-lab

# TLS certificate and key for HTTPS (self-signed for local dev)
HERMES_WEBUI_TLS_CERT=./certs/localhost.crt
HERMES_WEBUI_TLS_KEY=./certs/localhost.key

HERMES_WEBUI_STATE_DIR=/home/leap-aide/.hermes/webui